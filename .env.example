NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info
TIMEZONE=America/Argentina/Buenos_Aires

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pronostia

SCHEDULER_ENABLED=false
SCHEDULER_CRON=0 6 * * *
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

SPORTS_API_PROVIDER=api-football
SPORTS_API_BASE_URL=https://v3.football.api-sports.io
SPORTS_API_KEY=
SPORTS_API_DAILY_REQUEST_LIMIT=100
SPORTS_API_SOFT_LIMIT_PERCENT=70
SPORTS_API_MIN_INTERVAL_MS=7000
DISCOVERY_SMOKE_TEST=false
DISCOVERY_DRY_RUN=true
