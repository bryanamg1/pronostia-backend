NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info
TIMEZONE=America/Argentina/Buenos_Aires

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pronostia

SCHEDULER_ENABLED=false
SCHEDULER_CRON=0 6 * * *
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

SPORTS_API_PROVIDER=api-football
SPORTS_API_BASE_URL=https://v3.football.api-sports.io
SPORTS_API_KEY=
SPORTS_DEFAULT_SEASON=2026
SPORTS_API_SOFT_LIMIT_PERCENT=80
SPORTS_API_MIN_INTERVAL_MS=7000
SPORTS_API_RETRY_AFTER_FALLBACK_MS=65000
SPORTS_SYNC_LOOKAHEAD_HOURS=24
SPORTS_SYNC_MAX_FIXTURES=40
SPORTS_SYNC_HISTORY_MAX_PAGES_PER_RUN=2
ADMIN_API_TOKEN=
ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX_REQUESTS=20
OPENAI_API_KEY=
OPENAI_ENABLED=false
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
OPENAI_MONTHLY_BUDGET_USD=20
OPENAI_MONTHLY_ALERT_PERCENT=70
OPENAI_MONTHLY_DEGRADED_PERCENT=85
OPENAI_HARD_LIMIT_PERCENT=100
OPENAI_TIMEOUT_MS=30000
OPENAI_INPUT_COST_USD_PER_1M_TOKENS=0.25
OPENAI_CACHED_INPUT_COST_USD_PER_1M_TOKENS=0.025
OPENAI_OUTPUT_COST_USD_PER_1M_TOKENS=2
DISCOVERY_SMOKE_TEST=false
DISCOVERY_DRY_RUN=true
