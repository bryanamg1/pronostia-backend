{
  "name": "pronostia-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Layered backend foundation for PronostIA.",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:discovery": "node ./scripts/discovery/validate-api-football.test.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage --runInBand",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check .",
    "check": "npm run lint && npm run format:check && npm run test:discovery && npm test",
    "migrate": "node ./src/infrastructure/database/migrations/cli.js up",
    "migrate:status": "node ./src/infrastructure/database/migrations/cli.js status",
    "sync:sports": "node ./src/infrastructure/sports/cli.js",
    "sync:sports:history": "node ./src/infrastructure/sports/history-cli.js",
    "model:predict": "node ./src/infrastructure/prediction/cli.js",
    "model:evaluate": "node ./src/infrastructure/prediction/cli.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.14.3",
    "node-cron": "^4.2.1",
    "winston": "^3.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "jest": "^30.1.3",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4"
  }
}
